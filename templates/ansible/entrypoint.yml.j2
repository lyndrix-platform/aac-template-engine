---
# =============================================================================
# GLOBAL ANSIBLE ENTRYPOINT  —  generated by aac-template-engine
# -----------------------------------------------------------------------------
# Included by the service_rollout role (via `include_tasks`) before a native
# service is rolled out. This is the ONE global hook that runs for every
# ansible/native deployment: put cross-cutting default tasks here over time
# (common fact gathering, base packages, shared repo setup, …).
#
# For now it simply hands off to the service's self-contained role, which owns
# both install AND uninstall. The role lives next to this file at
# ./roles/service (rendered into deployments/ansible/roles/service).
#
# Service: {{ service.name }}
# =============================================================================

# --- global default tasks (extend platform-wide as needed) -------------------
# (none yet)

- name: "entrypoint | Run the {{ service.name }} service role"
  ansible.builtin.include_role:
    name: service
  # Native installs are inherently privileged (apt, systemd, /etc, keyrings).
  # become on include_role propagates to every task of the service role.
  become: true
