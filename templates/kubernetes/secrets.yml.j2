{% import '_helpers.jinja' as h %}
{# =========================================================================
   secrets.yml — one Opaque Secret <service>-secrets.

   Same data source as the compose `stack.env`: processed_secrets (the
   keyword-split, fully resolved secret map) plus every dependency's own
   `secrets:` block. Deployments reference keys via secretKeyRef; deps also
   inherit the whole Secret via envFrom (compose env_file parity).

   `stringData` is used on purpose — values stay plaintext in the manifest
   (like stack.env, which is equally gitignored). Rotate towards
   sealed-secrets/SOPS before committing rendered output anywhere public.

   AUTOGENERATED — fix the SSoT (service.yml) or this template, never the output.
   ========================================================================= #}
{% set k8s = deployments.kubernetes | default({}, true) %}
{% set ns = k8s.get('namespace', 'default') %}
{% set app = h.k8sname(service.name) %}
{% set all_secrets = {} %}
{% for key, value in (processed_secrets | default({}, true)).items() %}
{% set _ = all_secrets.update({key: value}) %}
{% endfor %}
{% for dep_key, dep in (dependencies | default({}, true)).items() %}
{% for key, value in (dep.secrets | default({}, true)).items() %}
{% set _ = all_secrets.update({key: value}) %}
{% endfor %}
{% endfor %}
{% if all_secrets %}
---
apiVersion: v1
kind: Secret
metadata:
  name: {{ app }}-secrets
  namespace: {{ ns }}
  labels:
    {{ h.std_labels(app, app) | indent(4) }}
type: Opaque
stringData:
{% for key, value in all_secrets | dictsort %}
  {{ key }}: {{ (value | string) | tojson }}
{% endfor %}
{% else %}
# No secrets defined in the SSoT — nothing to render.
{% endif %}
