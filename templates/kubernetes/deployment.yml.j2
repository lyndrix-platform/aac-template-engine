{% import '_helpers.jinja' as h %}
{# =========================================================================
   deployment.yml — one k8s Deployment for the main service + one per
   SSoT dependency (sidecars become their own Deployments; in-cluster DNS
   keeps the compose container names working via service.yml).

   AUTOGENERATED — fix the SSoT (service.yml) or this template, never the output.

   Override surface (all optional), designed to move into service.yml later:
     deployments.kubernetes.namespace          (default: "default")
     deployments.kubernetes.replicas           (default: 1)
     deployments.kubernetes.strategy           (default: Recreate)
     deployments.kubernetes.environment        (default: docker_compose.environment)
     deployments.kubernetes.resources          {requests/limits}
     deployments.kubernetes.image_pull_secrets [names]
     deployments.kubernetes.pod_spec           raw dict merged into pod spec
     deployments.kubernetes.container_spec     raw dict merged into main container
     deployments.kubernetes.dependencies.<name>.{environment,resources,replicas}
   ========================================================================= #}
{% set k8s = deployments.kubernetes | default({}, true) %}
{% set dc = deployments.docker_compose | default({}, true) %}
{% set ns = k8s.get('namespace', 'default') %}
{% set app = h.k8sname(service.name) %}
{% set secret_name = app ~ '-secrets' %}
{% set configmap_name = app ~ '-env' %}
{% set secret_keys = (processed_secrets | default({}, true)).keys() | list %}
{% set global_volumes = volumes | default({}, true) %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ app }}
  namespace: {{ ns }}
  labels:
    {{ h.std_labels(app, app) | indent(4) }}
spec:
  replicas: {{ k8s.get('replicas', 1) }}
  strategy:
    type: {{ k8s.get('strategy', 'Recreate') }}
  selector:
    matchLabels:
      app: {{ app }}
  template:
    metadata:
      labels:
        {{ h.std_labels(app, app) | indent(8) }}
    spec:
{% if k8s.get('image_pull_secrets') %}
      imagePullSecrets:
{% for s in k8s.image_pull_secrets %}
      - name: {{ s }}
{% endfor %}
{% endif %}
{% if dc.get('network_mode') == 'host' or config.get('routing_host_network') %}
      hostNetwork: true
      dnsPolicy: ClusterFirstWithHostNet
{% endif %}
{% if k8s.get('pod_spec') %}
{{ k8s.pod_spec | to_yaml(indent=2) | indent(6, first=true) }}
{% endif %}
      containers:
      - name: {{ app }}
        image: "{{ service.image_repo }}:{{ service.image_tag }}"
{% set port_list = ports | default([], true) %}
{% if port_list %}
        ports:
{% for p in port_list %}
        - name: {{ h.k8sname(p.name) }}
          containerPort: {{ p.port }}
          protocol: {{ p.protocol | default('TCP') }}
{% endfor %}
{% endif %}
{% set env_map = k8s.get('environment', dc.get('environment', {})) %}
{% if env_map %}
        {{ h.env_block(env_map, secret_keys, secret_name) | indent(8) }}
{% endif %}
{% set main_mounts = dc.get('volumes', []) %}
{% if main_mounts %}
        {{ h.volume_mounts(main_mounts) | indent(8) }}
{% endif %}
{% if h.has_security_context(dc) %}
        {{ h.security_context(dc) | indent(8) }}
{% endif %}
{% if dc.get('healthcheck') %}
        {{ h.probes(dc.healthcheck) | indent(8) }}
{% endif %}
        {{ h.resources(k8s.get('resources')) | indent(8) }}
{% if k8s.get('container_spec') %}
{{ k8s.container_spec | to_yaml(indent=2) | indent(8, first=true) }}
{% endif %}
{% if main_mounts %}
      {{ h.pod_volumes(main_mounts, {}, global_volumes, app) | indent(6) }}
{% endif %}
{% for dep_key, dep in (dependencies | default({}, true)).items() %}
{% set dep_app = h.k8sname(dep.name | default(service.name ~ '-' ~ dep_key)) %}
{% set dep_k8s = k8s.get('dependencies', {}).get(dep_key, {}) %}
{% set dep_secret_keys = (dep.secrets | default({}, true)).keys() | list %}
{# compose-parity: deps inherit .env/stack.env -> envFrom ConfigMap/Secret #}
{% set dep_inherits = dep.get('inherit_global_env', dc.get('dependencies_inherit_global_env', true)) %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ dep_app }}
  namespace: {{ ns }}
  labels:
    {{ h.std_labels(dep_app, app) | indent(4) }}
spec:
  replicas: {{ dep_k8s.get('replicas', 1) }}
  strategy:
    type: {{ dep_k8s.get('strategy', 'Recreate') }}
  selector:
    matchLabels:
      app: {{ dep_app }}
  template:
    metadata:
      labels:
        {{ h.std_labels(dep_app, app) | indent(8) }}
    spec:
{% if dep.get('network_mode') == 'host' %}
      hostNetwork: true
      dnsPolicy: ClusterFirstWithHostNet
{% endif %}
      containers:
      - name: {{ dep_app }}
        image: "{{ dep.image_repo }}:{{ dep.image_tag }}"
{% if dep_inherits %}
        {{ h.env_from(secret_name, configmap_name) | indent(8) }}
{% endif %}
{% set dep_env = dep_k8s.get('environment', dep.get('environment', {})) %}
{% set dep_env_all = {} %}
{% for k, v in dep_env.items() %}{% set _ = dep_env_all.update({k: v}) %}{% endfor %}
{% for k, v in (dep.secrets | default({}, true)).items() %}{% set _ = dep_env_all.update({k: v}) %}{% endfor %}
{% if dep_env_all %}
        {{ h.env_block(dep_env_all, dep_secret_keys, secret_name) | indent(8) }}
{% endif %}
{# prefer volume names that exist in the SSoT top-level volumes: map so the
   dedup keeps the entry a PVC was rendered for (catalog merge artifacts) #}
{% set dep_mounts = [] %}
{% for vn, vd in (dep.volumes | default({}, true)).items() if vd.get('target') and vn in global_volumes %}
{% set _ = dep_mounts.append(vn ~ ':' ~ vd.target) %}
{% endfor %}
{% for vn, vd in (dep.volumes | default({}, true)).items() if vd.get('target') and vn not in global_volumes %}
{% set _ = dep_mounts.append(vn ~ ':' ~ vd.target) %}
{% endfor %}
{% if dep_mounts %}
        {{ h.volume_mounts(dep_mounts) | indent(8) }}
{% endif %}
{% if h.has_security_context(dep) %}
        {{ h.security_context(dep) | indent(8) }}
{% endif %}
{% if dep.get('healthcheck') %}
        {{ h.probes(dep.healthcheck) | indent(8) }}
{% endif %}
        {{ h.resources(dep_k8s.get('resources')) | indent(8) }}
{% if dep_mounts %}
      {{ h.pod_volumes(dep_mounts, dep.volumes | default({}, true), global_volumes, app) | indent(6) }}
{% endif %}
{% endfor %}
