{% import '_helpers.jinja' as h %}
{# =========================================================================
   pvc.yml — one PersistentVolumeClaim per SSoT top-level named volume.

   Source of truth: the top-level `volumes:` map in service.yml.
     - entries with `type: bind` become hostPath mounts (no claim here)
     - every other entry gets a claim named <service>-<volume>

   Convention: declare ALL storage (main + dependencies) in the top-level
   `volumes:` map — dependency-local volume names without a top-level entry
   get no claim.

   Override surface (all optional):
     deployments.kubernetes.storage.class          (default: longhorn)
     deployments.kubernetes.storage.size           (default: 5Gi)
     deployments.kubernetes.storage.access_modes   (default: [ReadWriteOnce])
     deployments.kubernetes.volumes.<name>.size / .class / .access_modes

   AUTOGENERATED — fix the SSoT (service.yml) or this template, never the output.
   ========================================================================= #}
{% set k8s = deployments.kubernetes | default({}, true) %}
{% set ns = k8s.get('namespace', 'default') %}
{% set app = h.k8sname(service.name) %}
{% set storage = k8s.get('storage', {}) %}
{% set vol_overrides = k8s.get('volumes', {}) %}
{% for vol_name, vol_def in (volumes | default({}, true)).items() if (vol_def | default({}, true)).get('type') != 'bind' %}
{% set o = vol_overrides.get(vol_name, {}) %}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{ app }}-{{ h.k8sname(vol_name) }}
  namespace: {{ ns }}
  labels:
    {{ h.std_labels(app, app) | indent(4) }}
{% if (vol_def | default({}, true)).get('description') %}
  annotations:
    aac.fam-feser.de/description: {{ vol_def.description | tojson }}
{% endif %}
spec:
  accessModes:
{% for m in o.get('access_modes', storage.get('access_modes', ['ReadWriteOnce'])) %}
  - {{ m }}
{% endfor %}
  storageClassName: {{ o.get('class', storage.get('class', 'longhorn')) }}
  resources:
    requests:
      storage: {{ o.get('size', storage.get('size', '5Gi')) }}
{% endfor %}
