{% import '_helpers.jinja' as h %}
{# =========================================================================
   pvc.yml — one PersistentVolumeClaim per SSoT top-level named volume.

   Source of truth: the top-level `volumes:` map in service.yml.
     - entries with `type: bind` become hostPath mounts (no claim here)
     - every other entry gets a claim named <service>-<volume>

   Convention: declare ALL storage (main + dependencies) in the top-level
   `volumes:` map — dependency-local volume names without a top-level entry
   get no claim.

   Override surface (all optional) — keys match the deployments.kubernetes
   block already used in service.yml (e.g. aac-adguard):
     deployments.kubernetes.storage_class                       (default: longhorn)
     deployments.kubernetes.storage_size                        (default: 5Gi)
     deployments.kubernetes.access_modes                        (default: [ReadWriteOnce])
     deployments.kubernetes.persistent_volume_claims.<name>.storage_class
     deployments.kubernetes.persistent_volume_claims.<name>.size
     deployments.kubernetes.persistent_volume_claims.<name>.access_modes

   AUTOGENERATED — fix the SSoT (service.yml) or this template, never the output.
   ========================================================================= #}
{% set k8s = deployments.kubernetes | default({}, true) %}
{% set ns = k8s.get('namespace', 'default') %}
{% set app = h.k8sname(service.name) %}
{% set pvc_overrides = k8s.get('persistent_volume_claims', {}) %}
{% for vol_name, vol_def in (volumes | default({}, true)).items() if (vol_def | default({}, true)).get('type') != 'bind' %}
{% set o = pvc_overrides.get(vol_name, {}) %}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{ app }}-{{ h.k8sname(vol_name) }}
  namespace: {{ ns }}
  labels:
    {{ h.std_labels(app, app) | indent(4) }}
{% if (vol_def | default({}, true)).get('description') %}
  annotations:
    aac.fam-feser.de/description: {{ vol_def.description | tojson }}
{% endif %}
spec:
  accessModes:
{% for m in o.get('access_modes', k8s.get('access_modes', ['ReadWriteOnce'])) %}
  - {{ m }}
{% endfor %}
  storageClassName: {{ o.get('storage_class', k8s.get('storage_class', 'longhorn')) }}
  resources:
    requests:
      storage: {{ o.get('size', k8s.get('storage_size', '5Gi')) }}
{% endfor %}
