{% import '_helpers.jinja' as h %}
{# =========================================================================
   configmap.yml — shared non-secret environment (<service>-env).

   Same data source as the compose `.env`: processed_env. Dependencies
   inherit it via envFrom (compose env_file parity). With schema_version 2
   most services inline their env, so this is often empty — that is fine,
   the envFrom reference is marked `optional: true`.

   AUTOGENERATED — fix the SSoT (service.yml) or this template, never the output.
   ========================================================================= #}
{% set k8s = deployments.kubernetes | default({}, true) %}
{% set ns = k8s.get('namespace', 'default') %}
{% set app = h.k8sname(service.name) %}
{% set env_map = processed_env | default({}, true) %}
{% if env_map %}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ app }}-env
  namespace: {{ ns }}
  labels:
    {{ h.std_labels(app, app) | indent(4) }}
data:
{% for key, value in env_map | dictsort %}
  {{ key }}: {{ (value | string) | tojson }}
{% endfor %}
{% else %}
# No shared (non-secret) environment — nothing to render.
{% endif %}
