{% import '_helpers.jinja' as h %}
{# =========================================================================
   ingress.yml — Traefik IngressRoute objects (CRD), mirroring the compose
   routing 1:1.

   Instead of re-implementing the ingress logic, this reads back the labels
   the IngressProcessor already computed (processed_labels for the main
   service, dep.labels for dependencies): Host() rule, entrypoint, cert
   resolver and backend port. A dependency only gets a route when its labels
   carry traefik.enable=true — exactly like compose.

   Override surface (all optional):
     deployments.kubernetes.ingress.api_version    (default: traefik.io/v1alpha1)
     deployments.kubernetes.ingress.tls_secret     use a TLS secret instead of
                                                   the label's certResolver
     deployments.kubernetes.ingress.middlewares    [{name, namespace?}]

   AUTOGENERATED — fix the SSoT (service.yml) or this template, never the output.
   ========================================================================= #}
{% set k8s = deployments.kubernetes | default({}, true) %}
{% set ing = k8s.get('ingress', {}) %}
{% set ns = k8s.get('namespace', 'default') %}
{% set app = h.k8sname(service.name) %}
{% set api_version = ing.get('api_version', 'traefik.io/v1alpha1') %}
{% set labels_main = processed_labels | default({}, true) %}
{% macro ingress_route(route_name, labels, backend_service, fallback_port) %}
{% set rule = h.traefik_rule(labels) %}
{% set port = h.traefik_port(labels) | default(fallback_port, true) %}
{% if rule and port %}
---
apiVersion: {{ api_version }}
kind: IngressRoute
metadata:
  name: {{ route_name }}
  namespace: {{ ns }}
  labels:
    {{ h.std_labels(route_name, app) | indent(4) }}
spec:
  entryPoints:
  - {{ h.traefik_entrypoint(labels) | default('websecure', true) }}
  routes:
  - match: {{ h.traefik_rule(labels) }}
    kind: Rule
    services:
    - name: {{ backend_service }}
      port: {{ port }}
{% if ing.get('middlewares') %}
    middlewares:
{% for m in ing.middlewares %}
    - name: {{ m.name | default(m) }}
{% if m.namespace is defined %}
      namespace: {{ m.namespace }}
{% endif %}
{% endfor %}
{% endif %}
  tls:
{% if ing.get('tls_secret') %}
    secretName: {{ ing.tls_secret }}
{% else %}
    certResolver: {{ h.traefik_certresolver(labels) | default('default', true) }}
{% endif %}
{% else %}
# NOTE: '{{ route_name }}' has no complete traefik routing labels — no route rendered.
{% endif %}
{% endmacro %}
{% if labels_main.get('traefik.enable') == 'true' %}
{% set first_port = (ports | default([], true) | first | default({}, true)).get('port') %}
{{ ingress_route(app, labels_main, app, first_port) }}
{% else %}
# Traefik routing is disabled for {{ service.name }} (config.integrations.traefik.enabled).
{% endif %}
{% for dep_key, dep in (dependencies | default({}, true)).items() %}
{% set dep_labels = dep.labels | default({}, true) %}
{% if dep_labels.get('traefik.enable') == 'true' %}
{% set dep_app = h.k8sname(dep.name | default(service.name ~ '-' ~ dep_key)) %}
{{ ingress_route(dep_app, dep_labels, dep_app, none) }}
{% endif %}
{% endfor %}
