{% import '_helpers.jinja' as h %}
{# =========================================================================
   ingress.yml — Traefik IngressRoute objects (CRD), mirroring the compose
   routing 1:1, with cert-manager TLS.

   Instead of re-implementing the ingress logic, this reads back the labels
   the IngressProcessor already computed (processed_labels for the main
   service, dep.labels for dependencies): Host() rule, entrypoint, cert
   resolver and backend port. A dependency only gets a route when its labels
   carry traefik.enable=true — exactly like compose.

   TLS model (deployments.kubernetes.ingress.tls_mode):
     cert-manager  (DEFAULT) — emit a cert-manager Certificate CR requesting
                   <route>-tls from a ClusterIssuer/Issuer, and point the
                   IngressRoute at that Secret. This is the k3s path (the
                   ClusterIssuer holds the ionos/cloudflare DNS-01 solver;
                   the template only references it by name).
     secret        — use a pre-provisioned Secret (ingress.tls_secret_name);
                   no Certificate CR is emitted.
     resolver      — legacy Traefik built-in ACME (tls.certResolver from the
                   label); only works if Traefik's static config defines it.

   Override surface (all optional) — keys match the deployments.kubernetes
   block already used in service.yml (e.g. aac-adguard):
     ingress.enabled           false => render no route (even if label is on)
     ingress.tls_mode          cert-manager | secret | resolver  (default: cert-manager)
     ingress.cluster_issuer    issuer name (default: letsencrypt-<certresolver|prod>)
     ingress.issuer_kind       ClusterIssuer | Issuer            (default: ClusterIssuer)
     ingress.tls_secret_name   Secret name (default: <route>-tls; required for tls_mode=secret)
     ingress.class_name        -> kubernetes.io/ingress.class annotation
     ingress.api_version       (default: traefik.io/v1alpha1)
     ingress.middlewares       [{name, namespace?}]

   AUTOGENERATED — fix the SSoT (service.yml) or this template, never the output.
   ========================================================================= #}
{% set k8s = deployments.kubernetes | default({}, true) %}
{% set ing = k8s.get('ingress', {}) %}
{% set ns = k8s.get('namespace', 'default') %}
{% set app = h.k8sname(service.name) %}
{% set api_version = ing.get('api_version', 'traefik.io/v1alpha1') %}
{% set tls_mode = ing.get('tls_mode', 'cert-manager') %}
{% set issuer_kind = ing.get('issuer_kind', 'ClusterIssuer') %}
{% set labels_main = processed_labels | default({}, true) %}
{% macro ingress_route(route_name, labels, backend_service, fallback_port) %}
{% set rule = h.traefik_rule(labels) %}
{% set port = h.traefik_port(labels) | default(fallback_port, true) %}
{% if rule and port %}
{# --- pull the FQDN(s) out of the Host(`a`) || Host(`b`) rule (odd backtick segments) --- #}
{% set hosts = [] %}
{% for seg in rule.split('`') %}
{% if loop.index0 % 2 == 1 %}{% set _ = hosts.append(seg) %}{% endif %}
{% endfor %}
{% set issuer = ing.get('cluster_issuer', 'letsencrypt-' ~ (h.traefik_certresolver(labels) | default('prod', true))) %}
{% set tls_secret = ing.get('tls_secret_name', route_name ~ '-tls') if tls_mode == 'secret' else (route_name ~ '-tls') %}
---
apiVersion: {{ api_version }}
kind: IngressRoute
metadata:
  name: {{ route_name }}
  namespace: {{ ns }}
{% if ing.get('class_name') %}
  annotations:
    kubernetes.io/ingress.class: {{ ing.class_name }}
{% endif %}
  labels:
    {{ h.std_labels(route_name, app) | indent(4) }}
spec:
  entryPoints:
  - {{ h.traefik_entrypoint(labels) | default('websecure', true) }}
  routes:
  - match: {{ rule }}
    kind: Rule
    services:
    - name: {{ backend_service }}
      port: {{ port }}
{% if ing.get('middlewares') %}
    middlewares:
{% for m in ing.middlewares %}
    - name: {{ m.name | default(m) }}
{% if m.namespace is defined %}
      namespace: {{ m.namespace }}
{% endif %}
{% endfor %}
{% endif %}
  tls:
{% if tls_mode == 'resolver' %}
    certResolver: {{ h.traefik_certresolver(labels) | default('default', true) }}
{% else %}
    secretName: {{ tls_secret }}
{% endif %}
{% if tls_mode == 'cert-manager' and hosts %}
---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: {{ route_name }}-tls
  namespace: {{ ns }}
  labels:
    {{ h.std_labels(route_name, app) | indent(4) }}
spec:
  secretName: {{ tls_secret }}
  issuerRef:
    name: {{ issuer }}
    kind: {{ issuer_kind }}
  dnsNames:
{% for host in hosts %}
  - {{ host }}
{% endfor %}
{% elif tls_mode == 'cert-manager' and not hosts %}
# NOTE: '{{ route_name }}' has no Host() in its rule — cannot request a cert-manager Certificate.
{% endif %}
{% else %}
# NOTE: '{{ route_name }}' has no complete traefik routing labels — no route rendered.
{% endif %}
{% endmacro %}
{% if labels_main.get('traefik.enable') == 'true' and ing.get('enabled', true) %}
{% set first_port = (ports | default([], true) | first | default({}, true)).get('port') %}
{{ ingress_route(app, labels_main, app, first_port) }}
{% elif ing.get('enabled') == false %}
# Ingress disabled via deployments.kubernetes.ingress.enabled=false for {{ service.name }}.
{% else %}
# Traefik routing is disabled for {{ service.name }} (config.integrations.traefik.enabled).
{% endif %}
{% for dep_key, dep in (dependencies | default({}, true)).items() %}
{% set dep_labels = dep.labels | default({}, true) %}
{% if dep_labels.get('traefik.enable') == 'true' %}
{% set dep_app = h.k8sname(dep.name | default(service.name ~ '-' ~ dep_key)) %}
{{ ingress_route(dep_app, dep_labels, dep_app, none) }}
{% endif %}
{% endfor %}
