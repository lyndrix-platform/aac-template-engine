{% import '_helpers.jinja' as h %}
{# =========================================================================
   namespace.yml — rendered only when a non-default namespace is requested
   via deployments.kubernetes.namespace (and manage_namespace isn't false).

   AUTOGENERATED — fix the SSoT (service.yml) or this template, never the output.
   ========================================================================= #}
{% set k8s = deployments.kubernetes | default({}, true) %}
{% set ns = k8s.get('namespace', 'default') %}
{% if ns != 'default' and k8s.get('manage_namespace', true) %}
---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ ns }}
  labels:
    {{ h.std_labels(ns, h.k8sname(service.name)) | indent(4) }}
{% else %}
# Using the '{{ ns }}' namespace — no Namespace object managed here.
{% endif %}
