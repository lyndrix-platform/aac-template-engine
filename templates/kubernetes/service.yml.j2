{% import '_helpers.jinja' as h %}
{# =========================================================================
   service.yml — ClusterIP Services.

   Main service:  ports come from the SSoT top-level `ports:` list.
   Dependencies:  the Service NAME equals the compose container name
                  (e.g. aac-paperless-db) so env values like
                  "redis://aac-paperless-redis:6379" resolve unchanged.

   Dependency port resolution order (first hit wins):
     1. deployments.kubernetes.dependencies.<name>.ports  ([{name,port}] or [int])
     2. the dependency's own SSoT `ports:` list
     3. well-known default by image (postgres, redis, ...)
     4. the traefik loadbalancer.server.port label (ingress backends)
   A dependency without any resolvable port gets no Service (commented out).

   Direct L4 exposure (opt-in — Traefik-fronted services stay ClusterIP and
   need none of this; only DNS/MQTT-class services that want their own IP do):
     deployments.kubernetes.service_type            ClusterIP (default) | LoadBalancer | NodePort
     deployments.kubernetes.load_balancer_ip        pin a MetalLB pool IP
                                                    (emits the metallb.universe.tf
                                                     annotation + spec.loadBalancerIP)
     deployments.kubernetes.metallb_allow_shared_ip  share one IP across Services
                                                    (co-locate DNS TCP+UDP)
     deployments.kubernetes.external_traffic_policy  Cluster (default) | Local
                                                    (Local preserves client source IP)

   AUTOGENERATED — fix the SSoT (service.yml) or this template, never the output.
   ========================================================================= #}
{% set k8s = deployments.kubernetes | default({}, true) %}
{% set ns = k8s.get('namespace', 'default') %}
{% set app = h.k8sname(service.name) %}
{% set svc_type = k8s.get('service_type', 'ClusterIP') %}
{% set lb_ip = k8s.get('load_balancer_ip') %}
{% set shared_ip = k8s.get('metallb_allow_shared_ip') %}
{% set known_ports = {'postgres': 5432, 'postgresql': 5432, 'mariadb': 3306, 'mysql': 3306,
                      'redis': 6379, 'valkey': 6379, 'mongo': 27017, 'mongodb': 27017,
                      'rabbitmq': 5672, 'memcached': 11211, 'influxdb': 8086} %}
---
apiVersion: v1
kind: Service
metadata:
  name: {{ app }}
  namespace: {{ ns }}
{% if lb_ip or shared_ip %}
  annotations:
{% if lb_ip %}
    metallb.universe.tf/loadBalancerIPs: {{ lb_ip }}
{% endif %}
{% if shared_ip %}
    metallb.universe.tf/allow-shared-ip: {{ shared_ip }}
{% endif %}
{% endif %}
  labels:
    {{ h.std_labels(app, app) | indent(4) }}
spec:
  type: {{ svc_type }}
{% if lb_ip %}
  loadBalancerIP: {{ lb_ip }}
{% endif %}
{% if k8s.get('external_traffic_policy') and svc_type in ['LoadBalancer', 'NodePort'] %}
  externalTrafficPolicy: {{ k8s.external_traffic_policy }}
{% endif %}
  selector:
    app: {{ app }}
  ports:
{% for p in ports | default([], true) %}
  - name: {{ h.k8sname(p.name) }}
    port: {{ p.port }}
    targetPort: {{ p.port }}
    protocol: {{ (p.protocol | default('TCP')) | upper }}
{% if svc_type == 'NodePort' and p.external_port is defined and p.external_port >= 30000 and p.external_port <= 32767 %}
    nodePort: {{ p.external_port }}
{% endif %}
{% endfor %}
{% for dep_key, dep in (dependencies | default({}, true)).items() %}
{% set dep_app = h.k8sname(dep.name | default(service.name ~ '-' ~ dep_key)) %}
{% set dep_k8s = k8s.get('dependencies', {}).get(dep_key, {}) %}
{# --- resolve the dependency's service ports (see header) --- #}
{% set dep_ports = [] %}
{% for p in dep_k8s.get('ports', []) %}
{% set _ = dep_ports.append({'name': p.name | default('port-' ~ loop.index), 'port': p.port | default(p), 'protocol': p.protocol | default('TCP')}) %}
{% endfor %}
{% if not dep_ports %}
{% for p in dep.get('ports', []) %}
{% set _ = dep_ports.append({'name': p.name | default('port-' ~ loop.index), 'port': p.port | default(p), 'protocol': p.protocol | default('TCP')}) %}
{% endfor %}
{% endif %}
{% if not dep_ports %}
{% set image_base = dep.image_repo.split('/') | last %}
{% if image_base in known_ports %}
{% set _ = dep_ports.append({'name': image_base, 'port': known_ports[image_base], 'protocol': 'TCP'}) %}
{% endif %}
{% endif %}
{% if not dep_ports %}
{% set traefik_port = h.traefik_port(dep.labels | default({}, true)) %}
{% if traefik_port %}
{% set _ = dep_ports.append({'name': 'web', 'port': traefik_port | int, 'protocol': 'TCP'}) %}
{% endif %}
{% endif %}
{% if dep_ports %}
---
apiVersion: v1
kind: Service
metadata:
  name: {{ dep_app }}
  namespace: {{ ns }}
  labels:
    {{ h.std_labels(dep_app, app) | indent(4) }}
spec:
  type: ClusterIP
  selector:
    app: {{ dep_app }}
  ports:
{% for p in dep_ports %}
  - name: {{ h.k8sname(p.name) }}
    port: {{ p.port }}
    targetPort: {{ p.port }}
    protocol: {{ (p.protocol | default('TCP')) | upper }}
{% endfor %}
{% else %}
# NOTE: dependency '{{ dep_key }}' ({{ dep.image_repo }}) has no resolvable port —
# declare one via deployments.kubernetes.dependencies.{{ dep_key }}.ports in service.yml.
{% endif %}
{% endfor %}
